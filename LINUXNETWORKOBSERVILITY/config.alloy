loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

loki.source.syslog "udp" {
  listener {
    address  = "0.0.0.0:1514"
    protocol = "udp"
    labels = {
      job      = "syslog",
      protocol = "udp",
    }
  }

  forward_to = [
    loki.write.default.receiver,
  ]
}

loki.source.syslog "tcp" {
  listener {
    address  = "0.0.0.0:1515"
    protocol = "tcp"
    labels = {
      job      = "syslog",
      protocol = "tcp",
    }
  }

  forward_to = [
    loki.write.default.receiver,
  ]
}

// Tails the JSON-lines flow log that goflow2 writes for every
// NetFlow/IPFIX/sFlow record it decodes, and ships it to Loki.
// Labels go as extra keys on the target map, not a separate `labels` attr.
loki.source.file "netflow" {
  targets = [
    {__path__ = "/var/log/goflow2/flows.log", job = "netflow"},
  ]

  forward_to = [
    loki.write.default.receiver,
  ]
}
